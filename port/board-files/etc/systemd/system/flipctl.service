[Unit]
Description=Flipper OS control interface (Raspberry Pi)
After=network.target systemd-logind.service
Wants=systemd-logind.service
[Service]
User=user
Group=user
SupplementaryGroups=input video render dialout
PAMName=login
RuntimeDirectory=flipctl
Environment=HOME=/home/user
Environment=XDG_RUNTIME_DIR=/run/flipctl
Environment=FLIPPER_BLS_MIN_KERNEL=6.18
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
WorkingDirectory=/usr/share/flipctl
ExecStart=/usr/bin/flipctl --headless --remote 127.0.0.1:8899 --assets /usr/share/flipctl/assets/remote
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
