+impl Dispatch<wl_touch::WlTouch, ()> for State {
+    fn event(state: &mut Self, _: &wl_touch::WlTouch, event: wl_touch::Event,
+             _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        match event {
+            wl_touch::Event::Down { id, x, y, time, .. } if state.contact.is_none() => {
+                state.contact = Some(TouchContact { id, start: (x, y), last: (x, y), time });
+            }
+            wl_touch::Event::Motion { id, x, y, .. } => {
+                if let Some(c) = state.contact.as_mut().filter(|c| c.id == id) { c.last = (x, y); }
+            }
+            wl_touch::Event::Up { id, time, .. } => {
+                if state.contact.as_ref().is_some_and(|c| c.id == id) {
+                    let c = state.contact.take().unwrap();
+                    let key = touch_key(c.last.0 - c.start.0, c.last.1 - c.start.1,
+                                        time.wrapping_sub(c.time));
+                    state.keys.push_back(KeyEvent { key, down: true });
+                    state.keys.push_back(KeyEvent { key, down: false });
+                }
+            }
+            wl_touch::Event::Cancel => state.contact = None,
+            _ => {}
+        }
+    }
