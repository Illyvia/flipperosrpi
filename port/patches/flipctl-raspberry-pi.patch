+
+// Coordinates are compositor logical pixels (the Pi session uses 5x scaling).
+fn touch_key(dx: f64, dy: f64, duration_ms: u32) -> FlipperKey {
+    if dx.abs().max(dy.abs()) >= 12.0 {
+        if dx.abs() > dy.abs() {
+            if dx > 0.0 { FlipperKey::Right } else { FlipperKey::Left }
+        } else if dy > 0.0 { FlipperKey::Down } else { FlipperKey::Up }
+    } else if duration_ms >= 600 {
+        FlipperKey::Back
+    } else {
+        FlipperKey::Ok
+    }
+}
+
+fn presentation_size(w: u16, h: u16, width: Option<&str>, height: Option<&str>) -> io::Result<(u16, u16)> {
+    let dimension = |value: Option<&str>, minimum: u16| -> io::Result<u16> {
+        let n = match value {
+            None => minimum,
+            Some(s) => s.parse::<u16>().map_err(|_| io::Error::other("invalid Wayland surface dimension"))?,
+        };
+        if !(minimum..=4096).contains(&n) {
+            return Err(io::Error::other("Wayland surface must fit the UI and be at most 4096 pixels"));
+        }
+        Ok(n)
+    };
+    Ok((dimension(width, w)?, dimension(height, h)?))
+}
+
+// wl_shm Xrgb8888 uses little-endian B,G,R,X bytes on the Pi.
+fn presentation_palette(tint: &str) -> io::Result<[[u8; 4]; 256]> {
+    let white = match tint {
+        "grayscale" => [255u16, 255u16, 255u16],
+        "orange" => [255u16, 130u16, 0u16],
+        _ => return Err(io::Error::other("FLIPPER_WL_TINT must be grayscale or orange")),
+    };
+    Ok(std::array::from_fn(|i| {
+        let channel = |n: u16| ((i as u16 * n + 127) / 255) as u8;
+        [channel(white[2]), channel(white[1]), channel(white[0]), 255]
+    }))
+}
